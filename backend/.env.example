# Application Configuration
APP_NAME=RamaiahMart API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL with psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ramaiahmart
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000


# Security & Authentication (Generate secure 32+ char key in production)
JWT_SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# University Email Restriction (V1: only @msrit.edu accounts are accepted)
ALLOWED_EMAIL_DOMAINS=msrit.edu

# Object Storage (MinIO locally / AWS S3 in production)
# Local development uses MinIO with static credentials:
S3_ENDPOINT_URL=http://localhost:9100
S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=ramaiahmart-media
STORAGE_PRESIGNED_EXPIRATION_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# Production Note (AWS EC2 + AWS S3):
# - On EC2, credentials are automatically provided by the EC2 IAM instance role (ramaiahmart-ec2-role).
# - Do NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in production.
# - Leave S3_ENDPOINT_URL and S3_PUBLIC_ENDPOINT_URL empty to use AWS S3 defaults.
# - Set AWS_REGION=ap-south-1 and S3_BUCKET_NAME=<production-bucket-name>.

# AI Review & Moderation (Listing Text Review & Reactive Report Vision Review)
# Local development default: uses internal deterministic mock provider without external API calls
AI_TEXT_PROVIDER=mock
AI_TEXT_MODEL=mock_rule_engine_v1
AI_VISION_PROVIDER=mock
AI_VISION_MODEL=mock_vision_v1
AI_REQUEST_TIMEOUT_SECONDS=10.0

# Production AI Configuration:
# -----------------------------------------------------------------------------
# 1. Text Moderation (Direct Groq API on Listing Publication)
# Required in production when AI_TEXT_PROVIDER=groq:
# AI_TEXT_PROVIDER=groq
# AI_TEXT_MODEL=llama-3.3-70b-versatile
# AI_TEXT_API_KEY=your_groq_api_key_here
# AI_TEXT_BASE_URL=https://api.groq.com/openai/v1
#
# 2. Vision Moderation (Vercel AI Gateway on Image-Related Reports)
# Required in production when AI_VISION_PROVIDER=vercel:
# AI_VISION_PROVIDER=vercel
# AI_VISION_MODEL=openai/gpt-4o-mini
# AI_VISION_API_KEY=your_vercel_ai_gateway_key_here
# AI_VISION_BASE_URL=https://ai-gateway.vercel.sh/v1
#
# Optional Global Fallbacks (used if provider-specific key or base URL is omitted):
# AI_PROVIDER_API_KEY=your_shared_provider_key_here
# AI_PROVIDER_BASE_URL=https://api.openai.com/v1

