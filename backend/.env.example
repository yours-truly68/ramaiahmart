# Application Configuration
APP_NAME=RamaiahMart API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL with psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ramaiahmart
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000


# Security & Authentication (Generate secure 32+ char key in production)
JWT_SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# University Email Restriction (V1: only @msrit.edu accounts are accepted)
ALLOWED_EMAIL_DOMAINS=msrit.edu

# Object Storage (MinIO locally / AWS S3 in production)
S3_ENDPOINT_URL=http://localhost:9100
S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=ramaiahmart-media
STORAGE_PRESIGNED_EXPIRATION_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

